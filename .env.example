# DB API Marketplace credentials for the Timetables API.
# Create an application at https://developers.deutschebahn.com, subscribe it to
# "Timetables" (free plan), and paste the two values below. The client secret is
# shown only once at creation time.
DB_CLIENT_ID=
DB_API_KEY=

# Nebius training jobs (app/backend). Team default: eu-north1, 4x L40S node (verified 12 Sep, job aijob-e00d1m1qwztxqghv8g). Keep a single .env: make app/backend/.env a symlink to this file with
#   ln -s ../../.env app/backend/.env
# Auth comes from the Nebius CLI profile (`nebius profile create`); no token goes in this file.
NEBIUS_PROJECT_ID=project-e00g0c62pr00fj32s0h4gj
NEBIUS_SUBNET_ID=vpcsubnet-e00hf5r45dv0k0aa0b
NEBIUS_DEFAULT_PLATFORM=gpu-l40s-d
NEBIUS_DEFAULT_PRESET=4gpu-128vcpu-768gb
NEBIUS_DEFAULT_IMAGE=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime
NEBIUS_DEFAULT_TIMEOUT=2h
NEBIUS_DEFAULT_DISK_GIB=250
# Optional: the bucket's RESOURCE ID (storagebucket-...) to mount at /outputs for
# checkpoints. The API rejects both the bucket name and an s3:// URI with
# `invalid volume source`. Get it from `nebius storage bucket list`.
NEBIUS_OUTPUT_VOLUME=
# NEBIUS_CLI=/path/to/nebius

# S3 access key for uploading data and code to a Nebius bucket (nebius iam v2 access-key create).
NEBIUS_S3_ENDPOINT=https://storage.eu-north1.nebius.cloud
NEBIUS_S3_ACCESS_KEY_ID=
NEBIUS_S3_SECRET_ACCESS_KEY=

# app/backend product API (all optional). PORT defaults to 8000.
# CORS_ORIGIN=http://127.0.0.1:5173     # dev only, when the Vite dev server calls :8000 directly (the Vite proxy makes this unnecessary)
# STATIC_DIR=../frontend/dist           # built PWA served from the same origin as /api; default app/frontend/dist
# PREDICT_URL=http://127.0.0.1:8501/predict   # Python route model server (app/agents/src/features/db_route/serve_route.sh); unset -> deterministic mock prior
# CAUSES_URL=http://127.0.0.1:8501/causes     # same server, per-station cause families; unset -> bundled illustrative fixture
# PREDICT_FALLBACK_URL=http://127.0.0.1:8501/predict   # second model server for legs the first one only averaged (db_route serve_route.sh / serve_live.py relay)
# PREDICT_BACKEND=mock                  # mock | http (default: http when PREDICT_URL is set)
# PREDICT_TIMEOUT_MS=8000
# MIN_TRANSFER_MINUTES=5                # minutes needed to change trains when RIS::Stations connecting times are unavailable
# BAHN_VBID_RESOLVER=0                  # 1 -> best-effort resolve of share texts that only carry a bahn.de ?vbid= link
