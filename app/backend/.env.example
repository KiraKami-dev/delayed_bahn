# Copy to app/backend/.env (git-ignored). Loaded by src/server.js and the training CLI.

# ---- Nebius project wiring (required) -----------------------------------
# Administration -> Projects in https://console.nebius.com, or:
#   nebius iam v2 project list --parent-id <tenant_ID>
NEBIUS_PROJECT_ID=project-xxxxxxxxxxxxxxxxxxxx
# nebius vpc subnet list --parent-id $NEBIUS_PROJECT_ID   (metadata.id)
# Leave blank if the project has exactly one subnet: `npm run train doctor` fills it in.
NEBIUS_SUBNET_ID=

# ---- Auth: pick ONE of the three ------------------------------------------
# (a) Static token, 12h lifetime. Good for a laptop / hackathon session:
#       nebius iam get-access-token
# NEBIUS_ACCESS_TOKEN=

# (b) Service account (non-interactive, for a deployed backend). See README "Auth".
# NEBIUS_SA_ID=serviceaccount-xxxxxxxxxxxxxxxxxxxx
# NEBIUS_SA_KEY_ID=publickey-xxxxxxxxxxxxxxxxxxxx
# NEBIUS_SA_PRIVATE_KEY_FILE=./secrets/nebius-sa.pem

# (c) Nothing set: falls back to the Nebius CLI (`nebius iam get-access-token`)
#     using the active profile. Requires `nebius profile create` once.

# ---- Defaults for training jobs (all overridable per job) -----------------
NEBIUS_DEFAULT_PLATFORM=gpu-l40s-a
NEBIUS_DEFAULT_PRESET=1gpu-8vcpu-32gb
NEBIUS_DEFAULT_IMAGE=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime
NEBIUS_DEFAULT_TIMEOUT=2h
NEBIUS_DEFAULT_DISK_GIB=250
# Optional: bucket name/ID or s3://bucket to mount at /outputs for checkpoints.
NEBIUS_OUTPUT_VOLUME=

# ---- Backend server --------------------------------------------------------
PORT=8000
# Optional: where the nebius CLI binary lives (used only for `logs`).
# NEBIUS_CLI=/Users/you/.nebius/bin/nebius
