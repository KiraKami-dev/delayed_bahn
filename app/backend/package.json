{
  "name": "app-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API. Zero runtime dependencies: Node built-ins only (http, fetch, crypto).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test \"src/**/*.test.js\"",
    "train": "node src/features/training-jobs/cli.js",
    "train:doctor": "node src/features/training-jobs/cli.js doctor",
    "train:smoke": "node src/features/training-jobs/cli.js smoke"
  }
}
